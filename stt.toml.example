# stt ayarları. Kurulum (STT-Kurulum.exe) bunu stt.toml olarak kopyalar; uygulamadaki Ayarlar da buraya yazar.
# Komut satırı seçenekleri bu dosyadaki değerleri ezer.

out_dir = "cikti"                   # çıktı klasörü (ör. "D:/basin/cikti")
model = "large-v3"
compute_type = "float16"
beam_size = 5
gpus = "auto"                      # "auto" = monitörün bağlı OLMADIĞI kart (bilgisayar akıcı kalır)
                                   # "all" = bütün kartlar (en hızlı) | "0,1" | "0" | "cpu"
# display_batch = 4                # monitörlü kart kullanılırsa en fazla bu toplu boyut
# low_priority = true              # tanıma düşük öncelikte çalışır (bilgisayar donmasın)
# lang = "en"                      # yoksa otomatik

# Konuşmacı ayırma (pyannote). Token yerine HF_TOKEN ortam değişkeni de olur.
diarize = false
# hf_token = "hf_xxx"
td_label = "Teknik direktör"
reporter_label = "Muhabir"

# İndirme
cookies_browser = "auto"           # auto (kurulu tarayıcılar sırayla, Firefox önce) | firefox | edge | chrome | none
# cookies_file = "C:/Users/ben/cookies.txt"

# FPL
# fpl_repo = "D:/kod/fpl"
# fpl_python = "python3"           # boşsa: python3 -> py -3 -> stt'nin python'u

# OpenAI yedek motor (OPENAI_API_KEY ortam değişkeninden)
openai_model = "gpt-transcribe"
openai_workers = 4

# Bölme
split_min = 8                      # bundan uzun dosyalar VAD ile bölünür (dakika)
chunk_min = 5                      # hedef parça uzunluğu (dakika)
# browser_capture = true            # doğrudan inmeyen sitelerde gizli tarayıcıyla (Edge) video adresini yakala
# ytdlp_autoupdate = true           # yt-dlp günde bir kez güncellenir

# Ekran kartı / ses
# ui_gpu = false                    # arayüzde ekran kartı hızlandırması (kapalı = ekran kararmaz)
# agc = true                        # sessiz muhabir sorularını yükselt
# vad_threshold = 0.4

# Canlı yayın
# live_chunk_s = 20

# Kanal takibi
# follow_interval_h = 6

# Yapay zekâ (isteğe bağlı): gemini | claude | openai. Anahtarlar ortam değişkeninden de okunur
# (GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY). Bu dosyayı paylaşmayın.
# llm_provider = "gemini"
# llm_model = ""                    # boş: Gemini'de en yeni Flash, Claude'da claude-haiku-5-5
# llm_budget_usd = 5.0              # aylık sınır (tahmini)
# llm_news = false                  # her metin için haber taslağı
# llm_qa = true                     # konuşmacı ayrılamazsa soru-cevabı yapay zekâyla ayır

# Dış programlar
# api_port = 8765                   # http://127.0.0.1:8765/api/status
# api_token = "..."
# webhook_url = "https://..."
